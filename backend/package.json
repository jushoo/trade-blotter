{
  "name": "@trade-blotter/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "esbuild \"src/app.ts\" \"src/plugins/*.ts\" \"src/routes/**/index.ts\" --bundle --platform=node --format=esm --packages=external --outdir=dist --outbase=src",
    "start": "node dist/app.js",
    "lint": "echo \"backend lint (todo)\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/error": "^4.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "4.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
